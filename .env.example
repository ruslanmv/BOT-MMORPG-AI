# ==========================================
# BOT-MMORPG-AI Configuration
# ==========================================

# [MANDATORY] Google Gemini API Key
# This is required for the AI vision and decision-making features.
# You can get a free key here: https://aistudio.google.com/app/apikey
# Replace the placeholder below with your own key before running the app.
GEMINI_API_KEY=REPLACE_WITH_YOUR_GEMINI_API_KEY

# [OPTIONAL] OpenAI API Key (used only if AI_PROVIDER=openai)
# OPENAI_API_KEY=REPLACE_WITH_YOUR_OPENAI_API_KEY

# [OPTIONAL] AI Provider ("gemini" or "openai"). Default: gemini.
# AI_PROVIDER=gemini

# [OPTIONAL] Debug Mode
# Set to 'true' to see more detailed logs in the console during training/testing
DEBUG=false

# [OPTIONAL] Model Configuration
# If you want to force a specific model path (default is usually auto-detected)
# MODEL_PATH=./models/best_model.h5